{
    "name": "Question",
    "type": "object",
    "properties": {
        "question": {
            "type": "string"
        },
        "answer": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "certain",
                "uncertain",
                "needs_verification"
            ]
        },
        "reliabilityScore": {
            "type": "number"
        },
        "evidence": {
            "type": "string"
        },
        "evidenceMatch": {
            "type": "string",
            "enum": [
                "Strong",
                "Partial",
                "None"
            ]
        },
        "claimSupported": {
            "type": "boolean"
        },
        "signals": {
            "type": "object",
            "properties": {
                "evidenceSupport": {
                    "type": "number"
                },
                "semanticMatch": {
                    "type": "number"
                },
                "perplexity": {
                    "type": "number"
                },
                "answerRelevance": {
                    "type": "number"
                }
            }
        },
        "claims": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "claim": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "supported",
                            "partial",
                            "unsupported"
                        ]
                    },
                    "match": {
                        "type": "number"
                    },
                    "reason": {
                        "type": "string"
                    }
                }
            }
        },
        "sourceLabel": {
            "type": "string"
        },
        "decisionLogic": {
            "type": "string"
        },
        "piiDetected": {
            "type": "boolean"
        },
        "piiType": {
            "type": "string"
        },
        "shortExplanation": {
            "type": "string"
        },
        "explanation": {
            "type": "string"
        },
        "nextAction": {
            "type": "string"
        },
        "reviewStatus": {
            "type": "string",
            "enum": [
                "pending",
                "approved",
                "modified",
                "needs_verification"
            ],
            "default": "pending"
        },
        "riskLevel": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high"
            ],
            "default": "medium"
        },
        "humanReviewed": {
            "type": "boolean",
            "default": false
        },
        "reviewerRole": {
            "type": "string"
        },
        "reviewedAt": {
            "type": "string"
        },
        "reviewNote": {
            "type": "string"
        }
    },
    "required": [
        "question"
    ]
}