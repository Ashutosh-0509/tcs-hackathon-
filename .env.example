# ------------------------------------------------------------------
# TrustLens environment. Copy to .env and fill in. NEVER commit .env.
# ------------------------------------------------------------------

# --- Database ---
DATABASE_URL=postgresql+psycopg://trustlens:trustlens@postgres:5432/trustlens

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider ---
# stub  -> deterministic offline provider (no network, good for demo/CI)
# openai_compatible -> any OpenAI-compatible /v1 endpoint
LLM_PROVIDER=stub
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Reliability policy ---
CERTAIN_THRESHOLD=80
UNCERTAIN_THRESHOLD=50
WEIGHT_EVIDENCE=0.50
WEIGHT_SEMANTIC=0.25
WEIGHT_UNCERTAINTY=0.15
WEIGHT_RELEVANCE=0.10
EVIDENCE_SUPPORT_THRESHOLD=0.55

# --- Security ---
PII_USE_PRESIDIO=false
CORS_ALLOW_ORIGINS=http://localhost:3000
# Optional: regex OR-ed with the list above (e.g. Vercel preview deploys).
# CORS_ALLOW_ORIGIN_REGEX=https://tcs-hackathon(-[a-z0-9-]+)?\.vercel\.app
RATE_LIMIT_PER_MINUTE=60

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
